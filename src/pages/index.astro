---
import Layout from '../layouts/Layout.astro';
import '../styles/start.css';
import { FACTIONS, FACTION_NAMES, INVESTIGATORS, thumbImage } from '../scripts/investigators';

const sections = [...new Set(INVESTIGATORS.map((i) => i.section))];
const flip = 'M4 7h13l-3-3M20 17H7l3 3';
const close = 'M18 6 6 18M6 6l12 12';
const search = 'M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14zM16 16l5 5';
---

<Layout title="Gator Board" bodyClass="start">
  <div class="start-wrap">
    <header class="masthead">
      <h1>Gator Board</h1>
      <p>Choose an investigator to begin.</p>
    </header>

    <section class="session" id="session" hidden aria-labelledby="session-title">
      <img class="session-thumb" id="session-thumb" alt="" />
      <div class="session-info">
        <p class="eyebrow">Session in progress</p>
        <h2 id="session-title"></h2>
        <p class="session-stats" id="session-stats"></p>
        <p class="session-meta" id="session-meta"></p>
      </div>
      <div class="session-actions">
        <a class="btn primary" href="/play/">Continue</a>
        <p class="hint">Or choose an investigator below to start a new session.</p>
      </div>
    </section>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter by class">
        <button class="filter" data-faction="all" aria-pressed="true">All</button>
        {FACTIONS.map((f) => <button class={`filter f-${f}`} data-faction={f} aria-pressed="false">{FACTION_NAMES[f]}</button>)}
      </div>
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={search} /></svg>
        <input id="search" type="search" placeholder="Search name or set" autocomplete="off" />
      </label>
    </div>

    <p class="empty" id="empty" hidden>No investigators match.</p>

    {sections.map((section) => (
      <section class="group" data-section={section}>
        <h2>{section}</h2>
        <ul class="grid">
          {INVESTIGATORS.filter((i) => i.section === section).map((i) => (
            <li>
              <button
                class={`tile f-${i.faction}`}
                data-code={i.code}
                data-faction={i.faction}
                data-search={`${i.name} ${i.subname} ${i.set} ${i.section} ${FACTION_NAMES[i.faction]}`.toLowerCase()}
              >
                <img src={thumbImage(i.code)} alt="" loading="lazy" decoding="async" width="560" height="402" />
                <span class="tile-text">
                  <span class="tile-name">{i.name}</span>
                  <span class="tile-sub">{i.subname}</span>
                  <span class="tile-meta">
                    <span class="pip health" title="Health">{i.health}</span>
                    <span class="pip sanity" title="Sanity">{i.sanity}</span>
                    {i.section !== i.set && <span class="tile-set">{i.set}</span>}
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="sheet-scrim" id="detail" hidden>
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="detail-name">
      <button class="close" data-action="close-detail" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={close} /></svg>
      </button>
      <div class="detail-card">
        <img id="detail-img" alt="" />
        <button class="btn ghost flip" data-action="flip" id="detail-flip">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={flip} /></svg><span>Show back</span>
        </button>
      </div>
      <div class="detail-info">
        <p class="eyebrow" id="detail-faction"></p>
        <h2 id="detail-name"></h2>
        <p class="detail-sub" id="detail-sub"></p>
        <p class="detail-set" id="detail-set"></p>
        <p class="detail-stats">
          <span class="pip health" id="detail-health"></span> Health
          <span class="pip sanity" id="detail-sanity"></span> Sanity
          <span class="pip resource">5</span> Resources
        </p>
        <button class="btn primary wide" data-action="choose">Start playing</button>
      </div>
    </div>
  </div>

  <div class="sheet-scrim" id="confirm" hidden>
    <div class="confirm" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-text">
      <h2 id="confirm-title">Start a new session?</h2>
      <p id="confirm-text"></p>
      <div class="confirm-actions">
        <button class="btn ghost" data-action="cancel-new">Keep current session</button>
        <button class="btn danger" data-action="confirm-new">Start new session</button>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/start';
  </script>
</Layout>
